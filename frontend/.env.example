# ========================================================
# RoadGuardian 2.0 - Frontend (Vite) Environment Template
# Copy this file to .env and adjust for your environment.
# NEVER commit the real .env file!
# ========================================================

# Base URL of the FastAPI ML backend (read via import.meta.env.VITE_API_BASE_URL).
#
# Local development:
#   VITE_API_BASE_URL=http://localhost:8000
#
# Production (Vercel):
#   VITE_API_BASE_URL=<public HTTPS URL of the deployed FastAPI service>
#
# IMPORTANT: Vercel serves only the static frontend. It CANNOT run the
# PyTorch/FastAPI backend. A public HTTPS backend host is REQUIRED for the
# deployed UI; until one exists the CAM page will honestly report
# "MODEL SERVICE OFFLINE" (there is deliberately no mock fallback).
VITE_API_BASE_URL=http://localhost:8000
