# ========================================================
# RoadGuardian 2.0 - Environment Configuration Template
# Copy this file to .env and configure local paths/keys.
# NEVER commit .env to version control!
# ========================================================

# --- Dataset Paths (Local Only - Never Commit) ---
# Relative to repository root or system-specific path configured locally
GTSRB_DATASET_PATH=./data/local/GTSRB

# --- Backend Server Configuration ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- ML Model Inference Configuration ---
TRAFFIC_SIGN_MODEL_PATH=./ml/models/traffic_sign_detector.pt
DRIVER_MONITOR_MODEL_PATH=
INFERENCE_DEVICE=cpu
DETECTION_CONFIDENCE_THRESHOLD=0.50
DRIVER_DROWSINESS_EAR_THRESHOLD=0.25

# --- Map & Geocoding Services (Optional / Configurable) ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
