# ========================================================
# RoadGuardian 2.0 - Environment Configuration Template
# Copy this file to .env and configure local paths/keys.
# NEVER commit .env to version control!
# ========================================================

# --- Dataset Paths (Local Only - Never Commit) ---
# Relative paths are resolved against the repository root.
GTSRB_DATASET_PATH=./data/local/GTSRB

# --- Backend Server Configuration ---
# These names match backend/config.py exactly (Settings class).
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info

# Comma-separated list of browser origins allowed by CORS.
# Local development default: Vite dev (5173) + Vite preview (4173).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Regex applied in addition to CORS_ORIGINS (matches Vercel preview deployments).
CORS_ORIGIN_REGEX=^https://([a-z0-9-]+\.)*vercel\.app$

# --- ML Model Inference Configuration ---
# GTSRB ResNet-18 classifier weights (git-ignored, provisioned locally).
MODEL_WEIGHTS_PATH=./ml/models/gtsrb_baseline.pt
CASCADES_DIR=./ml/models/cascades
INFERENCE_DEVICE=cpu
DEFAULT_CONFIDENCE_THRESHOLD=0.50
DEFAULT_EAR_THRESHOLD=0.20

# --- Frontend (frontend/.env) ---
# VITE_API_BASE_URL=http://localhost:8000
# In production set VITE_API_BASE_URL to the public HTTPS backend URL.
# NOTE: a public backend host is still REQUIRED for the deployed frontend.

# --- Map & Geocoding Services (Optional / Configurable) ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# --- Map & Geocoding Services (Optional / Configurable) ---
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
